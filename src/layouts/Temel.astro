---
import "../styles/global.css";

interface Props {
  baslik: string;
  aciklama: string;
}

const { baslik, aciklama } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{baslik}</title>
    <meta name="description" content={aciklama} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><rect width='16' height='16' fill='%2310131a'/><rect x='3' y='3' width='4' height='4' fill='%2345c8bb'/><rect x='9' y='9' width='4' height='4' fill='%23eda14a'/></svg>" />
  </head>
  <body>
    <slot />
  </body>
</html>
